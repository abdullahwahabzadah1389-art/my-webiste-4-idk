# .env.example
# Your Resend API Key for sending emails (get one at https://resend.com)
RESEND_API_KEY=

# The email address where appointment and quote notification leads should be sent
ADMIN_EMAIL=trusttvmountingservices@gmail.com

# The sender email address. Since appointment.trusttvmounting.com is verified, use booking@appointment.trusttvmounting.com
SENDER_EMAIL=booking@appointment.trusttvmounting.com
